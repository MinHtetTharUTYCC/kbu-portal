@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1 class="mb-4">Admin Dashboard</h1>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-title text-muted">Total Students</h6>
                <h3 class="text-primary">@Model.TotalStudents</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-title text-muted">Total Teachers</h6>
                <h3 class="text-info">@Model.TotalTeachers</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-title text-muted">Total Subjects</h6>
                <h3 class="text-success">@Model.TotalSubjects</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-title text-muted">Total Announcements</h6>
                <h3 class="text-warning">@Model.TotalAnnouncements</h3>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Recent Announcements</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentAnnouncements.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No announcements yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.RecentAnnouncements)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@item.Title</strong>
                                        @if (item.IsPinned)
                                        {
                                            <span class="badge bg-warning ms-2">Pinned</span>
                                        }
                                        <br />
                                        <small class="text-muted">by @item.CreatedBy</small>
                                    </div>
                                    <small class="text-secondary">@item.CreatedAt.ToLocalTime().ToString("g")</small>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Top Subjects by Enrollment</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.TopSubjects.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No subjects yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.TopSubjects)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@item.Code</strong> — @item.Name
                                        <br />
                                        <small class="text-muted">@item.TeacherName</small>
                                    </div>
                                    <span class="badge bg-primary">@item.EnrolledStudents students</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
