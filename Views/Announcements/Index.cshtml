@model IReadOnlyList<AnnouncementViewModel>
@{
    ViewData["Title"] = "Announcements";
    var statusMessage = TempData["StatusMessage"] as string;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="mb-0">Announcements</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">New announcement</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-success">@statusMessage</div>
}
what i
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search announcements..." />
    </div>
    <div class="col-md-3">
        <select name="roleFilter" asp-items="@ViewBag.RoleFilter" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No announcements found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Target</th>
                    <th>Created</th>
                    <th>By</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var createdBy = string.IsNullOrWhiteSpace(item.CreatedByName)
                        ? item.CreatedByEmail
                        : item.CreatedByName.Trim();

                    <tr>
                        <td>
                            <div class="fw-semibold">@item.Title</div>
                            @if (item.IsPinned)
                            {
                                <span class="badge bg-warning text-dark">Pinned</span>
                            }
                            <div class="text-muted small">@item.Content</div>
                        </td>
                        <td>@item.TargetRole</td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td>@createdBy</td>
                        @if (User.IsInRole("Admin"))
                        {
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
