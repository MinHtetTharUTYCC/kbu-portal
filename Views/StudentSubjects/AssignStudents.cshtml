@model StudentSubjectAssignmentViewModel
@{
    ViewData["Title"] = $"Assign Students to {Model.SubjectCode}";
}

<h1 class="mb-3">Assign Students to @Model.SubjectCode</h1>
<p class="text-muted">@Model.SubjectName</p>

<form asp-action="AssignStudents" asp-route-subjectId="@Model.SubjectId" method="post">
    @Html.AntiForgeryToken()

    <div class="alert alert-info">
        Select students to assign them to this subject. Click "Save" to apply changes.
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th style="width: 50px;">Assign</th>
                    <th>Name</th>
                    <th>Student ID</th>
                    <th>Email</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Students.Count; i++)
                {
                    var student = Model.Students[i];
                    <tr>
                        <td>
                            <div class="form-check">
                                <input type="hidden" name="Students[@i].Id" value="@student.Id" />
                                <input type="hidden" name="Students[@i].Email" value="@student.Email" />
                                <input type="hidden" name="Students[@i].FullName" value="@student.FullName" />
                                <input type="hidden" name="Students[@i].StudentId" value="@student.StudentId" />
                                <input type="checkbox" name="Students[@i].IsAssigned" value="true" 
                                       @(student.IsAssigned ? "checked" : "") class="form-check-input" />
                            </div>
                        </td>
                        <td>@student.FullName</td>
                        <td>@(student.StudentId ?? "-")</td>
                        <td>@student.Email</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button type="submit" class="btn btn-primary">Save Assignments</button>
    <a asp-controller="Subjects" asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
